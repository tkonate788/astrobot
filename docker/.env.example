# ── AstroBot environment variables ───────────────────────────────
# Copy this file to `.env` (next to docker-compose.yml) and fill in
# real values. NEVER commit `.env` to git.

# Security — generate a strong random string for JWT_SECRET
JWT_SECRET=change_me_to_a_long_random_string

# PostgreSQL — must match an existing instance on the docker network
DB_HOST=postgre_container
DB_PORT=5432
DB_NAME=astrobot
DB_USER=astrobot_user
DB_PASSWORD=change_me

# n8n webhook (the one that routes messages through Mistral / Pixtral / etc.)
N8N_WEBHOOK=http://n8n:5678/webhook/astrobot

# HuggingFace API key — for image generation (FLUX), embeddings (RAG),
# image-to-image edit, and BLIP captioning. Free at https://huggingface.co/settings/tokens
HF_API_KEY=hf_your_token_here

# Groq API key (optional) — for audio transcription via Whisper.
# Free at https://console.groq.com/keys
GROQ_API_KEY=

# Admin seed account — used on first DB init only.
# This is the only account that can sign in to the /admin dashboard.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_to_a_strong_password
