# ── AstroBot secrets template ──────────────────────────────────
# Copy to docker/.env and fill in real values. Never commit docker/.env.

# JWT signing secret (32+ random chars)
JWT_SECRET=change_me_to_a_long_random_string

# PostgreSQL (existing container on the shared docker network)
DB_HOST=postgre_container
DB_PORT=5432
DB_NAME=astrobot
DB_USER=astrobot_user
DB_PASSWORD=change_me

# n8n webhook entry point (AstroBot workflow imported in n8n)
N8N_WEBHOOK=http://n8n:5678/webhook/astrobot

# HuggingFace token — free at https://huggingface.co/settings/tokens
HF_API_KEY=hf_xxx

# Optional: Groq key for Whisper audio transcription — https://console.groq.com/keys
GROQ_API_KEY=

# Admin account seeded on first boot (password re-applied on every boot)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_strong
